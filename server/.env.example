NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://your-site.example

# --- Database (get from MongoDB Atlas) ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/jharkhand_samadhan_setu

# --- Email OTP (get from resend.com) ---
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Jharkhand Samadhan Setu <noreply@your-verified-domain.example>

# --- File Upload (get from cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# --- JWT Signing Secret (REQUIRED - generate with: openssl rand -base64 32) ---
# This signs all government/startup session tokens. NEVER use a predictable value.
AUTH_SECRET=change-this-to-a-random-32-char-string

# --- AI Providers (optional, get from x.ai and google.com/ai) ---
# If keys are empty, the system falls back to local rules.
AI_PROVIDER_ORDER=grok,gemini
AI_PROVIDER=xai
AI_API_URL=https://api.x.ai/v1/chat/completions
AI_MODEL=grok-3-mini

# Get from console.x.ai -> API Keys (rotate if ever exposed)
XAI_API_KEY=

# Get from Google AI Studio -> API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embedding Provider (optional, for startup matching feature) ---
# Get from platform.openai.com -> API Keys
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Circuit Breaker (tuning, optional) ---
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=60000
CB_WINDOW_MS=300000
