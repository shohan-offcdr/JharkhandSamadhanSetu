NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://your-site.example
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/jharkhand_samadhan_setu
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Jharkhand Samadhan Setu <noreply@your-verified-domain.example>
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
# Signing key for the government / startup account tokens (utils/token.js).
# Required in production; JWT_SECRET is accepted as a fallback name.
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-long-random-string
# Multi-provider AI enrichment (server/.env only — never in site/).
# The chain is Grok -> Gemini -> local rules. Every provider is optional: leave
# both keys empty and submissions are enriched by the local-rules engine
# (analysisVersion local-semantic-v2, aiProviderUsed local_rules).
AI_PROVIDER_ORDER=grok,gemini
AI_PROVIDER=xai
AI_API_URL=https://api.x.ai/v1/chat/completions
AI_MODEL=grok-3-mini
# Preferred Grok key. Falls back to AI_API_KEY if XAI_API_KEY is blank.
XAI_API_KEY=
AI_TIMEOUT_MS=15000
# Google Gemini (second provider). Needs `npm install @google/generative-ai`.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Circuit breaker: N failures inside CB_WINDOW_MS skip that provider for
# CB_COOLDOWN_MS, so a degraded provider stops slowing every submission.
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=60000
CB_WINDOW_MS=300000
