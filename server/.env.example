# Comma-separated list of origins allowed to call this API.
# file:// pages send no Origin header, so this is only needed once the site is served over http(s).
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Resend (email OTP) ---
# Get a free key at resend.com -- no card required. 3,000 emails/month free.
RESEND_API_KEY=re_BDYh5gFQ_JLwJnebZDaKDps1iCJt6PD9c
# Resend's shared sandbox sender -- works with zero setup. Switch to your own
# verified domain later (e.g. "no-reply@yourdomain.in") once you have one.
EMAIL_FROM=Jharkhand Samadhan Setu <onboarding@resend.dev>

# --- xAI Grok enrichment (SERVER-ONLY) ---
# This key bills your xAI account. Rules:
#  - NEVER commit this file (server/.env is gitignored — verified below).
#  - NEVER put this key in site/ (browsers expose everything there).
#  - The key below was pasted in chat, so it is EXPOSED: rotate it at
#    console.x.ai -> API Keys -> delete -> create new -> paste the new one here.
AI_PROVIDER=xai
AI_API_URL=https://api.x.ai/v1/chat/completions
AI_MODEL=grok-3-mini
AI_API_KEY=xai-ei7Jau8zkqwPl3OxWlLNQCVOW3OMhb412S2fVulim4K8OzKJKVHWkXoCNXaDh3JT793G0taSB74AgNVX
AI_TIMEOUT_MS=15000
AUTH_SECRET=qr32ol41ye9vtuzd7fa06mcshbjwp5ixngk8

# --- AI provider fallback (appended, server-only) -----------------------------
# Provider order controls failover. Default: grok first, then gemini.
AI_PROVIDER_ORDER=grok,gemini
#
# xAI Grok (preferred key). Falls back to the legacy AI_API_KEY above if this
# is blank. Rotate the exposed AI_API_KEY at console.x.ai and use XAI_API_KEY.
XAI_API_KEY=xai-ei7Jau8zkqwPl3OxWlLNQCVOW3OMhb412S2fVulim4K8OzKJKVHWkXoCNXaDh3JT793G0taSB74AgNVX
#
# Google Gemini (second provider). Requires `npm install @google/generative-ai`.
GEMINI_API_KEY=AQ.Ab8RN6LKOhQgLWJ56MtKW4y4zhl9OtIy7Mcn13EGrBeAOUkI6w
GEMINI_MODEL=gemini-1.5-flash
#
# Circuit breaker: N failures within CB_WINDOW_MS opens the breaker for
# CB_COOLDOWN_MS, so a degraded provider is skipped instead of slowing every
# grievance submission.
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=60000
CB_WINDOW_MS=300000